  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95c64e0778f40354b86ae41d86a125a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: Tubby the Kid
  chatBubblePrefab: {fileID: 8118450732210544728, guid: 6eb2ca46f0da35e4c87e18c45bd6b1bf, type: 3}
  promptAnchorOffset: {x: 0, y: 0.12}
  promptTilt: 0.5
  focusHeight: 0.75
  dialogueText: 'Whewww brother, I hear tell your ship got pretty boogered up on the way down. Gonna be scrapin'' dimes together for years. I''m meeting the hangman come sundown, so I reckon this change is of higher use to you than me. '
  dialogueBubblePrefab: {fileID: 7400100000000000001, guid: 04655dae6d21cbb40bf62a655543b151, type: 3}
  dialogueAnchorOffset: {x: -0.2, y: 0.06}
  dialogueScale: 1
  fitDialogueToView: 1
  viewMargin: 0.04
  dialogueAudio: {fileID: 8300000, guid: 808c4ee4b08d10441bd83cc7e5bcc6b5, type: 3}
  moneyReward: 200
  foodReward: 0
  drinksReward: 0
  reputationReward: -5
  rewardOnlyOnce: 1
  returnDialogueText: 'Real nice of you to come visit me again on my last day, Partner. If''n a had a sidekick as loyal as you, I reckon I''d never have ended up here in the first place. '
  returnMoneyReward: 0
  returnFoodReward: 0
  returnDrinksReward: 0
  returnReputationReward: 10
  returnRewardOnlyOnce: 1
  hasShop: 0
  shopMinReputation: 1
  shopTitle: 
  shopItems: []
  hideWhileInteracting:
  - {fileID: 458310739}
